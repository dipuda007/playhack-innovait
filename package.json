{
  "name": "playhack",
  "version": "1.0.0",
  "private": true,
  "description": "PlayHack — IIT Guwahati sports facility booking. Team InnovAIT.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:push": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "setup": "npm run db:reset",
    "test": "vitest run",
    "test:race": "vitest run tests/race.test.ts",
    "invariant": "tsx scripts/invariant.ts",
    "e2e": "tsx scripts/e2e.mts",
    "media": "tsx scripts/media.mts",
    "infographic": "tsx scripts/infographic.mts",
    "deck": "tsx scripts/deck.mts && python scripts/deck.py",
    "deck:extras": "python scripts/deck_pdf.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "eslint-config-next": "15.5.24",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^17.4.2",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.6"
  }
}
